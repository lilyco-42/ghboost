<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ghboost"
            android:textColor="#e94560"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="loading..."
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!--
          授權聲明入口。APK 里带着 GPL-3.0 的 libmihomo.so / libsingbox.so 与
          MPL-2.0 的 libxray.so（build-all.yml 注入 jniLibs），分发义务要求把
          许可证正文交给用户 —— 但 assets/licenses/ 是 build-all.yml 在**构建时**
          塞进去的，源码树里根本没有 assets/ 目录，也就是说「打进包里」不等于
          「用户看得到」。这个按钮就是补上后半截。

          放在版本号底下而不是页面最底：许可证这类东西要能被找到，藏在最底
          等于没有。做成小字按钮，避免和 Scan/Start/Stop 抢注意力。
        -->
        <Button
            android:id="@+id/btnLicenses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="授權聲明 Licenses"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#0f3460" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#16c784"
            android:textSize="16sp"
            android:background="#0f3460"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 内核选择器（多内核：自動 / 內建 / Mihomo / Xray / sing-box）-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="內核 Engine"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 三内核可用性 + 运行中内核状态（nativeCoreStatus 轮询）-->
        <TextView
            android:id="@+id/tvEngineInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="內核可用性載入中…"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#16213e"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scan"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#0f3460" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#16c784" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop"
                android:backgroundTint="#e94560"
                android:enabled="false" />
        </LinearLayout>

        <!--
          测速（nativeTest）。以前 nativeTest 只有 FFI 导出、没有任何 UI 入口，
          Android 端拿不到 alive 指标 —— 唯一的出网路径（Start）又被 tunReady
          挡着，于是「节点清单到底能不能用」这件事在手机上永远无法自证。
          单独一行而不是塞进上面那排：三个主按钮的语义是「VPN 生命周期」，
          测速是「体检」，混在一排会让人以为按它会连上去。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test 測速"
                android:backgroundTint="#0f3460" />

            <TextView
                android:id="@+id/tvTestHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:paddingStart="12dp"
                android:paddingEnd="0dp"
                android:text="测 Scan 出来的节点能不能连"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Nodes output -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nodes"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap Scan to discover nodes"
            android:textColor="#cccccc"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="#16213e"
            android:padding="12dp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
