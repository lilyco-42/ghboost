<?xml version="1.0" encoding="windows-1252"?>
<!--
  ghboost MSI installer template for cargo-wix
  Features: Desktop shortcut, Start Menu, Uninstaller

  NOTE (WiX v3 schema):
  <Fragment> may ONLY be a child of <Wix>, never nested inside <Product>.
  Both shortcut fragments used to live inside <Product>, which makes candle's
  schema validation fail (cargo-wix reports "candle failed with exit code = 10").
  They are now siblings of <Product> and linked in via <ComponentRef>.

  NOTE (encoding): this file declares windows-1252, so it MUST stay pure ASCII.
  Non-ASCII bytes here (e.g. UTF-8 Chinese in a comment) are undefined in cp1252
  and make the XML parser bail out with an invalid-character error.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="ghboost"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Manufacturer="lilyco"
    Language="1033"
    Codepage="1252"
    Version="$(var.Version)">

    <Package
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="perMachine"
      Description="ghboost - GitHub Access Accelerator"
      Manufacturer="lilyco"
      Comments="GitHub access acceleration with proxy nodes"
      Platform="x64" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit."
      AllowSameVersionUpgrades="yes" />

    <Media Id="1" Cabinet="ghboost.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1" />
    <Property Id="DiskPrompt" Value="ghboost Installation" />

    <!-- Directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Must be ProgramFiles64Folder, not ProgramFilesFolder: the components are
           Win64="yes", and installing a 64-bit component into a 32-bit directory makes
           light fail with LGHT0204 / ICE80 "This 64BitComponent MainExecutable uses
           32BitDirectory APPLICATIONFOLDER". Package/@Platform is set to x64 above. -->
      <Directory Id="ProgramFiles64Folder" Name="PFiles">
        <Directory Id="APPLICATIONFOLDER" Name="ghboost" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="ApplicationProgramsFolder" Name="ghboost" />
      </Directory>
    </Directory>

    <!-- Features -->
    <Feature Id="Complete" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Icon -->
    <Icon Id="ghboost.exe" SourceFile="$(var.CargoTargetBinDir)\ghboost.exe" />
    <Property Id="ARPPRODUCTICON" Value="ghboost.exe" />

    <!-- No UI dialog set - uses MSI built-in UI (avoids WixUIExtension dependency) -->
  </Product>

  <!-- Start Menu folder -->
  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="B5C6D7E8-F901-2345-6789-ABCDEF012345" Win64="yes">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="ghboost"
          Description="GitHub Access Accelerator"
          Target="[APPLICATIONFOLDER]ghboost.exe"
          WorkingDirectory="APPLICATIONFOLDER"
          Icon="ghboost.exe" />
        <RemoveFolder Id="CleanUpShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\lilyco\ghboost" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- Desktop shortcut -->
  <Fragment>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="D7E8F901-2345-6789-ABCD-EF0123456789" Win64="yes">
        <Shortcut
          Id="ApplicationDesktopShortcut"
          Name="ghboost"
          Description="GitHub Access Accelerator"
          Target="[APPLICATIONFOLDER]ghboost.exe"
          WorkingDirectory="APPLICATIONFOLDER"
          Icon="ghboost.exe" />
        <RegistryValue Root="HKCU" Key="Software\lilyco\ghboost" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- Components -->
  <Fragment>
    <DirectoryRef Id="APPLICATIONFOLDER">
      <Component Id="MainExecutable" Guid="C4D5E6F7-0123-4567-89AB-CDEF01234567" Win64="yes">
        <File
          Id="exe"
          Name="ghboost.exe"
          DiskId="1"
          Source="$(var.CargoTargetBinDir)\ghboost.exe"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
